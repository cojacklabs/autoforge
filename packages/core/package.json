{
  "name": "@cojacklabs/autoforge-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./intent": {
      "types": "./dist/intent.d.ts",
      "import": "./dist/intent.js"
    },
    "./planning": {
      "types": "./dist/planning.d.ts",
      "import": "./dist/planning.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration.d.ts",
      "import": "./dist/orchestration.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/intent.ts src/planning.ts src/orchestration.ts src/ports.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\"",
    "boundaries": "node ../config/src/check-boundaries.mjs"
  },
  "dependencies": {
    "@cojacklabs/autoforge-protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "turbo": {
    "tags": [
      "public",
      "library"
    ]
  }
}
