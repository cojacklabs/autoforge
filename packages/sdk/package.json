{
  "name": "@cojacklabs/autoforge-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\"",
    "boundaries": "node ../config/src/check-boundaries.mjs"
  },
  "dependencies": {
    "@cojacklabs/autoforge-core": "workspace:^",
    "@cojacklabs/autoforge-protocol": "workspace:^"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "turbo": {
    "tags": [
      "private",
      "library"
    ]
  }
}
