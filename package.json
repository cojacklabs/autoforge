{
  "name": "@cojacklabs/autoforge",
  "version": "0.11.7",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./scripts/clean_dist.js && tsup",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "planning:check": "node ./scripts/check_planning_bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:foundation && npm run test:legacy",
    "test:foundation": "npm run build && vitest run",
    "test:legacy": "node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "bin": {
    "autoforge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "dependencies": {
    "@piotrjura/pm": "^0.5.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "glob": "^10.5.0",
    "ignore": "^5.3.1",
    "prettier": "^3.3.3",
    "repomix": "^1.18.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
