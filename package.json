{
  "name": "@cojacklabs/autoforge",
  "version": "0.25.2",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./scripts/clean_dist.js && tsup",
    "changeset": "changeset",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "planning:check": "node ./scripts/check_planning_bundle.mjs",
    "release:publish": "changeset publish",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:foundation && npm run test:legacy",
    "test:foundation": "npm run build && vitest run",
    "test:legacy": "node --test tests/*.test.js",
    "core:build": "node ./scripts/clean_dist.js && tsup",
    "core:typecheck": "tsc --noEmit",
    "core:test:foundation": "vitest run",
    "core:test:legacy": "node --test tests/*.test.js",
    "core:format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "core:planning:check": "node ./scripts/check_planning_bundle.mjs",
    "workspace:build": "turbo run core:build",
    "workspace:typecheck": "turbo run core:typecheck",
    "workspace:test": "turbo run core:test:foundation core:test:legacy",
    "workspace:format:check": "turbo run core:format:check",
    "workspace:planning:check": "turbo run core:planning:check",
    "workspace:check": "turbo run core:build core:typecheck core:test:foundation core:test:legacy core:format:check core:planning:check",
    "prepack": "npm run build"
  },
  "bin": {
    "autoforge": "bin/autoforge.js"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "dependencies": {
    "@cojacklabs/autoforge-core": "^0.1.1",
    "@cojacklabs/autoforge-protocol": "^0.1.0",
    "@cojacklabs/autoforge-sdk": "^0.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "glob": "^10.5.0",
    "ignore": "^5.3.1",
    "prettier": "^3.3.3",
    "repomix": "^1.18.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
