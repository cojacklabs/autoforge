{
  "name": "@cojacklabs/autoforge-agent",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "autoforge-agent": "bin/autoforge-agent.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"bin/**/*.js\" \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\"",
    "boundaries": "node ../../packages/config/src/check-boundaries.mjs"
  },
  "dependencies": {
    "@cojacklabs/autoforge-protocol": "workspace:^",
    "@cojacklabs/autoforge-providers": "workspace:^",
    "@cojacklabs/autoforge-sdk": "workspace:^",
    "@napi-rs/keyring": "^1.3.0",
    "ai": "^6.0.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "turbo": {
    "tags": [
      "app"
    ]
  }
}
